/* ===== 训练页 WXSS ===== */
.container{display:flex;flex-direction:column;align-items:center;padding:20rpx 30rpx;height:100vh;box-sizing:border-box;overflow-y:auto}

/* 阶段指示器 */
.phase-dots{display:flex;gap:12rpx;margin-bottom:20rpx}
.phase-dot{width:60rpx;height:10rpx;border-radius:10rpx;background:#2a2a3a;transition:all .3s}
.phase-dot.active{background:#f97316;width:100rpx}
.phase-dot.done{background:#22c55e}
.phase-label{font-size:24rpx;color:#9ca3af;margin-bottom:6rpx}
.phase-title{font-size:36rpx;font-weight:800;margin-bottom:20rpx;background:linear-gradient(135deg,#f97316,#ef4444);-webkit-background-clip:text;-webkit-text-fill-color:transparent}

/* 计时器环 */
.timer-wrap{position:relative;margin-bottom:16rpx}
.timer-ring{position:relative;width:260rpx;height:260rpx}
.ring-bg{position:absolute;inset:0;border-radius:50%;background:#2a2a3a}
.ring-progress{position:absolute;inset:6rpx;border-radius:50%}
.ring-inner{position:absolute;inset:16rpx;border-radius:50%;background:#0f0f14;display:flex;flex-direction:column;align-items:center;justify-content:center}
.timer-val{font-size:84rpx;font-weight:900;font-variant-numeric:tabular-nums;line-height:1}
.timer-val.rep{font-size:42rpx;color:#f97316}
.timer-unit{font-size:24rpx;color:#9ca3af}
.pause-overlay{position:absolute;inset:0;border-radius:50%;background:rgba(15,15,20,.75);display:flex;align-items:center;justify-content:center}
.pause-icon{font-size:60rpx}

/* 计数 */
.ex-counter{font-size:22rpx;color:#6b7280;margin-bottom:14rpx}

/* 动作卡片 */
.ex-card{background:#1a1a24;border:1rpx solid #2a2a3a;border-radius:24rpx;padding:30rpx;width:100%;box-sizing:border-box;margin-bottom:20rpx;text-align:center}
.ex-card.fade-in{animation:fadeIn .35s ease}
@keyframes fadeIn{from{opacity:0;transform:translateY(10rpx)}to{opacity:1;transform:translateY(0)}}
.ex-cn{font-size:44rpx;font-weight:800;display:block;margin-bottom:6rpx;line-height:1.2}
.ex-en{font-size:24rpx;color:#6b7280;display:block;margin-bottom:16rpx}
.ex-meta{display:flex;justify-content:center;gap:16rpx;margin-bottom:14rpx;flex-wrap:wrap}
.meta-highlight{background:#252533;padding:8rpx 20rpx;border-radius:40rpx;font-size:22rpx;color:#f97316;font-weight:700}
.meta-normal{background:#252533;padding:8rpx 20rpx;border-radius:40rpx;font-size:22rpx;color:#d1d5db}
.ex-cues{font-size:22rpx;color:#9ca3af;line-height:1.5;padding:14rpx 20rpx;background:#14141e;border-radius:16rpx;text-align:center}

/* 按钮 */
.btn-row{display:flex;gap:14rpx;width:100%;margin-top:auto;padding-top:20rpx}
.btn{flex:1;padding:20rpx 10rpx;border-radius:18rpx;font-size:28rpx;font-weight:700;text-align:center;background:transparent;border:none;color:#d1d5db;line-height:1.2}
.btn::after{border:none}
.btn-primary{background:linear-gradient(135deg,#f97316,#ea580c);color:#fff}
.btn-secondary{background:#252533;border:1rpx solid #3a3a4a!important}
.btn-skip{background:transparent;border:1rpx solid #3a3a4a!important;color:#6b7280}
.btn-pause{background:#252533;border:1rpx solid #3a3a4a!important;flex:0 0 80rpx;min-width:80rpx}

.voice-note{font-size:20rpx;color:#6b7280;margin-top:10rpx}

/* 小屏适配 */
@media(max-width:320px){
  .timer-ring{width:200rpx;height:200rpx}
  .timer-val{font-size:64rpx}
  .ex-cn{font-size:36rpx}
  .btn{font-size:24rpx;padding:16rpx 6rpx}
}
